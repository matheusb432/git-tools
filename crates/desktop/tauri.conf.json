{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gtl-viewer",
  "version": "0.1.0",
  "identifier": "dev.gittools.viewer",
  "build": {
    "frontendDist": "./dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "git-tools diff viewer",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}

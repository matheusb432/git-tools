{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["unicorn", "typescript", "oxc", "import"],
  "ignorePatterns": [
    "crates/preview/src/embedded/generated",
    "crates/desktop/src/embedded/generated",
    "node_modules",
    "target"
  ],
  "overrides": [
    {
      "files": ["frontend/inline/*.ts"],
      "rules": {
        "no-unused-vars": "off"
      }
    }
  ]
}

# justfile.snippet — add these to the HOST repo's justfile (this crate is an embedded
# workspace member, NOT a standalone repo: there is no `install` recipe and no install shim).
#
# 1. Add the crate to the host workspace's root `Cargo.toml`:
#        [workspace]
#        members = [ ..., "tools/xtask" ]
#
# 2. Add one-line forwarder recipes — recipe bodies stay thin; logic lives in the verbs.
#    Mirror these into the host's per-domain `just/<domain>.justfile` modules as they grow.

# One-time dev-host setup: installs the toolchain (bootstrap.sh) then runs the Rust bootstrap verb.
bootstrap *args:
    sh tools/xtask/bootstrap.sh {{ args }}

# Example automation verb (replace with the real ones: test / up / ship / …).
check *args:
    cargo run --quiet -p xtask -- check {{ args }}

{
  "name": "git-tools-preview",
  "private": true,
  "type": "module",
  "scripts": {
    "fix": "oxlint frontend/diff frontend/viewer --fix && oxfmt frontend/diff frontend/viewer .oxfmtrc.json .oxlintrc.json package.json tsconfig.json",
    "format": "oxfmt frontend/diff frontend/viewer .oxfmtrc.json .oxlintrc.json package.json tsconfig.json",
    "format:check": "oxfmt --check frontend/diff frontend/viewer .oxfmtrc.json .oxlintrc.json package.json tsconfig.json",
    "lint": "svelte-check --tsconfig tsconfig.json && oxlint frontend/diff frontend/viewer --deny-warnings"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@lucide/svelte": "^1.21.0",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.1",
    "bun-types": "^1.3.14",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "shadcn-svelte": "^1.3.0",
    "svelte": "^5.56.4",
    "svelte-check": "4.7.2",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.6.0",
    "vite": "^8.1.0"
  }
}

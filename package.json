{
  "name": "git-tools-preview",
  "private": true,
  "type": "module",
  "scripts": {
    "fix": "oxlint frontend/diff frontend/core --fix && oxfmt frontend/diff frontend/core .oxfmtrc.json .oxlintrc.json package.json tsconfig.json",
    "format": "oxfmt frontend/diff frontend/core .oxfmtrc.json .oxlintrc.json package.json tsconfig.json",
    "format:check": "oxfmt --check frontend/diff frontend/core .oxfmtrc.json .oxlintrc.json package.json tsconfig.json",
    "lint": "svelte-check --tsconfig tsconfig.json && oxlint frontend/diff frontend/core --deny-warnings"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "bun-types": "^1.3.14",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "svelte": "^5.56.4",
    "svelte-check": "4.7.2",
    "typescript": "^5.6.0",
    "vite": "^8.1.0"
  }
}

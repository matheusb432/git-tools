{
  "name": "git-tools-preview",
  "private": true,
  "type": "module",
  "scripts": {
    "check:viewer-fsd": "steiger frontend/viewer",
    "fix": "oxlint frontend/diff frontend/viewer --fix && oxfmt frontend/diff frontend/viewer .oxfmtrc.json .oxlintrc.json package.json steiger.config.ts tsconfig.json",
    "format": "oxfmt frontend/diff frontend/viewer .oxfmtrc.json .oxlintrc.json package.json steiger.config.ts tsconfig.json",
    "format:check": "oxfmt --check frontend/diff frontend/viewer .oxfmtrc.json .oxlintrc.json package.json steiger.config.ts tsconfig.json",
    "lint": "svelte-check --tsconfig tsconfig.json && oxlint frontend/diff frontend/viewer --deny-warnings",
    "test:viewer-components": "vitest run --config frontend/viewer/vitest.config.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@lucide/svelte": "^1.21.0",
    "@tanstack/svelte-query": "5.90.2",
    "@tanstack/svelte-virtual": "3.13.31",
    "@xstate/store-svelte": "2.0.0",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "0.6.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "14.6.1",
    "@wdio/cli": "9.29.1",
    "@wdio/local-runner": "9.29.1",
    "@wdio/mocha-framework": "9.29.1",
    "@wdio/spec-reporter": "9.29.1",
    "bun-types": "^1.3.14",
    "happy-dom": "20.10.6",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "shadcn-svelte": "^1.3.0",
    "steiger": "0.5.13",
    "svelte": "^5.56.4",
    "svelte-check": "4.7.2",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.6.0",
    "vite": "^8.1.0",
    "vitest": "4.1.10",
    "webdriverio": "9.29.1"
  }

{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortPackageJson": {
    "sortScripts": true
  },
  "ignorePatterns": [
    "crates/gtl-preview/src/embedded/generated",
    "crates/gtl-desktop/src/embedded/generated",
    "node_modules",
    "target"
  ]
}
